# 复制本文件为 config.env 后按实际环境修改。config.env 已被 .gitignore 忽略，不要提交真实凭据。

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=7001
SERVER_HTTPS_PORT=7443
SERVER_SSL_CERT=certs/server.crt
SERVER_SSL_KEY=certs/server.key

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=multivideo
DB_AUTH_PLUGIN=mysql_native_password

# Student browser local client gateway for wiring detection
LOCAL_CLIENT_BASE=http://127.0.0.1:6001

# Server-side face recognition service
FACE_RECOGNITION_BASE=http://127.0.0.1:6001
FACE_LIBRARY_DIR=/home/server/faces
FACE_MATCH_THRESHOLD=85

# Login redirect base. Leave empty to use current server host.
# STUDENT_WEB_BASE=http://your-server-ip:7001/student
# TEACHER_WEB_BASE=http://your-server-ip:7001/teacher

# Standalone student/teacher web servers
STUDENT_WEB_HOST=127.0.0.1
STUDENT_WEB_PORT=8088
STUDENT_WEB_SECRET_KEY=change-me-student-secret
TEACHER_WEB_HOST=127.0.0.1
TEACHER_WEB_PORT=8090
TEACHER_WEB_SECRET_KEY=change-me-teacher-secret

# Rule service
RULE_SERVER_IP=127.0.0.1
RULE_SERVER_PORT=8000

# Ollama defaults used by backend APIs
OLLAMA_CHAT_HOST=127.0.0.1
OLLAMA_CHAT_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_QUESTION_HOST=127.0.0.1
OLLAMA_QUESTION_PORT=11434
OLLAMA_QUESTION_MODEL=qwen2.5:1.5b

# Ollama defaults injected into student page
FRONTEND_OLLAMA_HOST=localhost
FRONTEND_OLLAMA_PORT=11434
FRONTEND_OLLAMA_MODEL=qwen2.5:1.5b
